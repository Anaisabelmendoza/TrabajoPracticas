<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Archivo de Incidencia #{{ ticket.id }}</title>
    <style>
        @page {
            margin: 100px 50px 80px 50px;
        }
        body {
            font-family: 'Helvetica', sans-serif;
            color: #2d3748;
            line-height: 1.6;
            font-size: 12px;
            margin: 0;
            padding: 0;
        }
        
        /* Cabecera Fija */
        .header-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 5px;
        }
        .header-logo-text {
            font-size: 20px;
            font-weight: 900;
            color: #8e2de2;
            letter-spacing: 1px;
        }
        .header-logo-sub {
            font-size: 10px;
            color: #718096;
            font-weight: bold;
            margin-top: 2px;
        }
        .header-meta-title {
            font-size: 14px;
            font-weight: 800;
            color: #2d3748;
            text-align: right;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .header-meta-date {
            font-size: 9px;
            color: #a0aec0;
            text-align: right;
            margin-top: 3px;
        }
        .brand-bar {
            height: 3px;
            background-color: #8e2de2;
            margin-bottom: 25px;
            width: 100%;
            border-radius: 2px;
        }

        /* Sección Titulo con Barra Izquierda */
        .section-title {
            border-left: 4px solid #8e2de2;
            padding-left: 10px;
            font-size: 12px;
            font-weight: 800;
            color: #1a202c;
            margin-top: 25px;
            margin-bottom: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* Cuadrícula de Tarjetas KPI utilizando Tabla Borde Cero */
        .kpi-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 10px;
            margin-bottom: 15px;
            margin-left: -10px;
            margin-right: -10px;
        }
        .kpi-card {
            width: 50%;
            background-color: #f7fafc;
            border: 1px solid #edf2f7;
            border-radius: 8px;
            padding: 12px 15px;
            vertical-align: top;
        }
        .kpi-label {
            font-size: 9px;
            color: #a0aec0;
            text-transform: uppercase;
            font-weight: 800;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }
        .kpi-value {
            font-size: 12px;
            font-weight: 700;
            color: #2d3748;
        }
        .kpi-id-pill {
            display: inline-block;
            background-color: #e8f0fe;
            color: #1a73e8;
            padding: 2px 8px;
            border-radius: 20px;
            font-weight: 900;
            font-size: 14px;
        }

        /* Bloque de descripción */
        .description-box {
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 15px;
            color: #4a5568;
            font-size: 12px;
            line-height: 1.6;
        }

        /* Timeline de comentarios */
        .comment-box {
            background-color: #ffffff;
            border: 1px solid #edf2f7;
            border-radius: 8px;
            margin-bottom: 12px;
            padding: 12px 15px;
        }
        .comment-header {
            border-bottom: 1px solid #f7fafc;
            padding-bottom: 6px;
            margin-bottom: 8px;
        }
        .comment-author {
            font-weight: 800;
            color: #4a5568;
            font-size: 11px;
        }
        .comment-date {
            font-size: 9px;
            color: #a0aec0;
            float: right;
        }
        .comment-body {
            color: #4a5568;
            font-size: 11.5px;
            line-height: 1.5;
        }
        .comment-attachment {
            font-size: 9.5px;
            color: #8e2de2;
            margin-top: 6px;
            font-weight: bold;
        }

        /* Tablas Zebra Premium */
        .zebra-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid #edf2f7;
        }
        .zebra-table th {
            background-color: #8e2de2;
            color: #ffffff;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 9.5px;
            letter-spacing: 0.5px;
            padding: 10px 12px;
            text-align: left;
        }
        .zebra-table td {
            padding: 10px 12px;
            border-bottom: 1px solid #edf2f7;
            color: #4a5568;
        }
        .zebra-table tr:nth-child(even) td {
            background-color: #f7fafc;
        }

        /* Badges de prioridad estilizados */
        .badge {
            font-size: 9px;
            padding: 3px 8px;
            border-radius: 12px;
            text-transform: uppercase;
            font-weight: 800;
            display: inline-block;
        }
        .badge-baja { background-color: #e8f5e9; color: #2e7d32; }
        .badge-media { background-color: #fff3e0; color: #ef6c00; }
        .badge-alta { background-color: #ffebee; color: #c62828; }
        .badge-crítica { background-color: #b71c1c; color: #ffffff; }

        /* Pie de página Fijo */
        .footer {
            position: fixed;
            bottom: -50px;
            left: 0px;
            right: 0px;
            height: 30px;
            border-top: 1px solid #edf2f7;
            padding-top: 8px;
        }
        .footer-left {
            float: left;
            font-size: 9px;
            color: #a0aec0;
            font-weight: bold;
        }
        .footer-right {
            float: right;
            font-size: 9px;
            color: #a0aec0;
        }
        .page-number:before {
            content: "Página " counter(page);
        }
    </style>
</head>
<body>
    <!-- Cabecera de Reporte -->
    <table class="header-table">
        <tr>
            <td>
                <div class="header-logo-text">HELPDESK PRO</div>
                <div class="header-logo-sub">SISTEMA INTEGRAL DE SOPORTE TÉCNICO</div>
            </td>
            <td>
                <div class="header-meta-title">Archivo Técnico de Incidencia</div>
                <div class="header-meta-date">Generado el {{ date|date('d/m/Y H:i') }}</div>
            </td>
        </tr>
    </table>
    <div class="brand-bar"></div>

    <!-- Rejilla de Información del Ticket (KPI Cards) -->
    <table class="kpi-table">
        <tr>
            <td class="kpi-card">
                <div class="kpi-label">Código del Ticket</div>
                <div class="kpi-value">
                    <span class="kpi-id-pill">#{{ ticket.id }}</span>
                </div>
            </td>
            <td class="kpi-card">
                <div class="kpi-label">Prioridad de Atención</div>
                <div class="kpi-value" style="margin-top: 3px;">
                    <span class="badge badge-{{ ticket.priority|lower }}">{{ ticket.priority }}</span>
                </div>
            </td>
        </tr>
        <tr>
            <td class="kpi-card">
                <div class="kpi-label">Usuario Solicitante</div>
                <div class="kpi-value" style="font-size: 11px;">
                    <strong>{{ ticket.author.firstName }} {{ ticket.author.lastName }}</strong><br>
                    <span style="color: #718096; font-size: 10px;">{{ ticket.author.email }}</span>
                </div>
            </td>
            <td class="kpi-card">
                <div class="kpi-label">Detalles de Gestión</div>
                <div class="kpi-value" style="font-size: 11px; line-height: 1.4;">
                    <span style="color: #718096;">Estado:</span> <strong>{{ ticket.status }}</strong><br>
                    {% if ticket.agent %}
                        <span style="color: #718096;">Técnico Asignado:</span> <strong>{{ ticket.agent.firstName }} {{ ticket.agent.lastName }}</strong>
                    {% else %}
                        <span style="color: #a0aec0; font-style: italic;">Sin Técnico Asignado</span>
                    {% endif %}
                </div>
            </td>
        </tr>
    </table>

    <div class="section-title">Detalles de la Incidencia</div>
    <div class="description-box">
        <div style="font-size: 13px; font-weight: 800; color: #2d3748; margin-bottom: 8px; border-bottom: 1px solid #edf2f7; padding-bottom: 6px;">
            {{ ticket.title }}
        </div>
        <div style="font-size: 10.5px; color: #a0aec0; margin-bottom: 8px;">
            Apertura oficial el {{ ticket.createdAt|date('d/m/Y a las H:i') }}
        </div>
        <div style="white-space: pre-wrap;">{{ ticket.description }}</div>
    </div>

    <!-- Registro de comentarios / Timeline -->
    {% if ticket.comments|length > 0 %}
        <div class="section-title" style="page-break-before: auto;">Historial de Comunicaciones</div>
        {% for comment in ticket.comments %}
            <div class="comment-box" style="page-break-inside: avoid;">
                <div class="comment-header">
                    <span class="comment-author">{{ comment.authorName }}</span>
                    <span class="comment-date">{{ comment.createdAt|date('d/m/Y H:i') }}</span>
                </div>
                <div class="comment-body">
                    {{ comment.content|nl2br }}
                </div>
                {% if comment.attachmentPath %}
                    <div class="comment-attachment">
                        Adjunto asociado: {{ comment.attachmentPath }}
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    {% endif %}

    <!-- Registro de tiempos de trabajo -->
    {% if ticket.workLogs|length > 0 %}
        <div class="section-title" style="page-break-before: auto;">Registro de Tiempos Trabajados</div>
        <div style="page-break-inside: avoid;">
            <table class="zebra-table">
                <thead>
                    <tr>
                        <th style="width: 15%;">Fecha</th>
                        <th style="width: 25%;">Técnico a Cargo</th>
                        <th style="width: 15%; text-align: right;">Minutos</th>
                        <th style="width: 45%;">Descripción del Trabajo</th>
                    </tr>
                </thead>
                <tbody>
                    {% for log in ticket.workLogs %}
                        <tr>
                            <td>{{ log.createdAt|date('d/m/Y') }}</td>
                            <td><strong>{{ log.agent.firstName }} {{ log.agent.lastName }}</strong></td>
                            <td style="text-align: right;"><strong>{{ log.minutesSpent }} min</strong></td>
                            <td>{{ log.description }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    <!-- Pie de página fijo -->
    <div class="footer">
        <span class="footer-left">REGISTRO OFICIAL DE ARCHIVO - HELPDESK PRO</span>
        <span class="footer-right page-number"></span>
    </div>
</body>
</html>
