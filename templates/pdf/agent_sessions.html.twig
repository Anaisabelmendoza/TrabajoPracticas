<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Informe de Actividad</title>
    <style>
        body { font-family: Helvetica, Arial, sans-serif; font-size: 12px; color: #333; }
        .header { text-align: center; margin-bottom: 20px; }
        .info-box { border: 1px solid #ccc; padding: 15px; margin-bottom: 20px; background: #f9f9f9; border-radius: 5px; }
        .info-box h3 { margin: 0 0 10px 0; font-size: 16px; color: #8e2de2; }
        .info-box p { margin: 5px 0; font-size: 13px; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: center; }
        th { background-color: #8e2de2; color: white; text-transform: uppercase; }
        tr:nth-child(even) { background-color: #f2f2f2; }
        .footer { text-align: center; font-size: 10px; color: #777; margin-top: 30px; }
    </style>
</head>
<body>
    <div class="header">
        <h2 style="margin: 0; color: #333;">INFORME DE ACTIVIDAD MENSUAL</h2>
        <p style="margin-top: 5px; color: #666;">Mes: <strong>{{ monthName }} {{ year }}</strong></p>
    </div>

    {%- set totalWorkMinutes = 0 -%}
    {%- for day, data in dailyStats -%}
        {%- set totalWorkMinutes = totalWorkMinutes + data.workMinutes -%}
    {%- endfor -%}

    <div class="info-box">
        <h3>Técnico: {{ agent.firstName }} {{ agent.lastName }}</h3>
        <p><strong>Email:</strong> {{ agent.email }}</p>
        <p><strong>Rol:</strong> {% if 'ROLE_ADMIN' in agent.roles %}Administrador{% else %}Agente{% endif %}</p>
        <p><strong>Total Horas Conexión en App:</strong> {{ (totalMinutes // 60) }}h {{ (totalMinutes % 60) }}m</p>
        <p><strong>Total Tiempo en Incidencias:</strong> {{ (totalWorkMinutes // 60) }}h {{ (totalWorkMinutes % 60) }}m</p>
    </div>

    <table>
        <thead>
            <tr>
                <th style="width: 20%;">Día</th>
                <th style="width: 40%;">Minutos en App</th>
                <th style="width: 40%;">Trabajo (Tickets)</th>
            </tr>
        </thead>
        <tbody>
            {% for day, data in dailyStats %}
            <tr>
                <td><strong>{{ day }}</strong></td>
                <td>
                    {% if data.totalMinutes > 0 %}
                        {{ (data.totalMinutes // 60) }}h {{ (data.totalMinutes % 60) }}m
                    {% else %}
                        <span style="color: #999;">-</span>
                    {% endif %}
                </td>
                <td style="color: #2e7d32; font-weight: bold;">
                    {% if data.workMinutes > 0 %}
                        {{ (data.workMinutes // 60) }}h {{ (data.workMinutes % 60) }}m
                    {% else %}
                        <span style="color: #999;">-</span>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="footer">
        Generado el {{ "now"|date("d/m/Y H:i") }} - HelpDesk Pro
    </div>
</body>
</html>
